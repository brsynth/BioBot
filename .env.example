# Database configuration
# You can choose any values you like for DB_NAME, DB_USER, and DB_PASSWORD

DB_HOST=postgres
DB_PORT=5432
DB_NAME=biobotdb
DB_USER=biobotuser
DB_PASSWORD=biobotpass

#Openai API key, input your openai api key value "sk-..."
API_KEY=your_api_key

# Comma-separated server owner emails (Administration: Users and Devices)
BIOBOT_ADMINS=

# Build the initial shared device catalog in the background (1 = enabled)
BIOBOT_CATALOG_ENABLED=1
# Initial inventory size; additional models are always discovered on request.
# Set to 0 to keep searching until discovery finds no additional models.
BIOBOT_CATALOG_INITIAL_LIMIT=50

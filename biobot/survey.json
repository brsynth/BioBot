{
  "_notes": "Not shown to respondents. Pages = title + questions; types: scale, choice, multi, text. Every question is required unless \"optional\": true; \"unless\": {\"question_id\": \"answer\"} hides it when that answer was given. Questions are placeholders to replace.",
  "title": "BioBot user survey",
  "intro": "Thank you for testing BioBot. This survey takes about 3 minutes.",
  "pages": [
    {
      "title": "About you",
      "questions": [
        {
          "id": "role",
          "type": "choice",
          "text": "What is your role?",
          "options": [
            "Biologist",
            "Automation engineer",
            "Bioinformatician",
            "Other"
          ]
        }
      ]
    },
    {
      "title": "Using BioBot",
      "questions": [
        {
          "id": "ease",
          "type": "scale",
          "text": "BioBot was easy to use.",
          "min": 1,
          "max": 5,
          "labels": [
            "Strongly disagree",
            "Strongly agree"
          ]
        },
        {
          "id": "trust",
          "type": "scale",
          "text": "I would run the generated protocol on a real device.",
          "min": 1,
          "max": 5,
          "labels": [
            "Strongly disagree",
            "Strongly agree"
          ]
        },
        {
          "id": "features",
          "type": "multi",
          "text": "Which features did you use?",
          "options": [
            "Chat",
            "Deck editing",
            "Simulation playback",
            "Code export"
          ]
        }
      ]
    },
    {
      "title": "The generated code",
      "questions": [
        {
          "id": "code_tested",
          "type": "choice",
          "text": "Did you test the code generated by BioBot?",
          "options": [
            "Yes, on the real device",
            "Yes, in the device's simulator or software only",
            "No"
          ]
        },
        {
          "id": "code_device",
          "type": "text",
          "text": "If yes, on which device?",
          "unless": {
            "code_tested": "No"
          }
        },
        {
          "id": "code_result",
          "type": "choice",
          "text": "If yes, what was the result?",
          "options": [
            "Ran as expected",
            "Ran after minor manual edits",
            "Ran but did the wrong thing",
            "Did not run (error)"
          ],
          "unless": {
            "code_tested": "No"
          }
        },
        {
          "id": "code_result_details",
          "type": "text",
          "text": "If it did not work as expected, what happened?",
          "unless": {
            "code_tested": "No",
            "code_result": "Ran as expected"
          }
        }
      ]
    },
    {
      "title": "Comments",
      "questions": [
        {
          "id": "comments",
          "type": "text",
          "text": "Any comments or suggestions?",
          "optional": true
        }
      ]
    }
  ]
}